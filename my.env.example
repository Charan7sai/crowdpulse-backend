# Copy to my.env (and add my.env + camera_settings.json to .gitignore!)

# ── Camera: pick ONE ─────────────────────────────────────────
# Phone (Android "IP Webcam" app -> Start server -> use the IP it shows):
CAMERA_SOURCE=http://192.168.1.50:8080/video

# CCTV (RTSP). Examples:
# CAMERA_SOURCE=rtsp://admin:PASSWORD@192.168.1.64:554/Streaming/Channels/101
# CAMERA_SOURCE=rtsp://admin:PASSWORD@192.168.1.108:554/cam/realmonitor?channel=1&subtype=0

# Laptop webcam:
# CAMERA_SOURCE=0

# (Optional) the website can change the camera later; that choice is saved in
# camera_settings.json and overrides CAMERA_SOURCE on restart.

CAMERA_MAX_WIDTH=960        # big CCTV streams are downscaled for speed

# ── Auto-recalibration ───────────────────────────────────────
AUTO_CALIBRATE_ENABLED=true
AUTO_CALIBRATE_INTERVAL_SEC=30       # how often to check/recalibrate
AUTO_CALIBRATE_SKIP_WHEN_EMPTY=true  # skip when nobody is in frame
CALIBRATION_SMOOTHING=0.6            # 0 = jump to each new estimate

# ── Optional protection for /camera/* changes ────────────────
# CAMERA_ADMIN_TOKEN=some-long-random-string   (frontend must send X-Admin-Token)

# ── Existing settings ────────────────────────────────────────
ZONE_NAME=Main Hall
ZONE_AREA_M2=50
FLASK_PORT=5001
